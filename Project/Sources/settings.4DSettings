<?xml version="1.0" encoding="UTF-8"?><preferences stamp="60">
	<com.4d>
		<deployment>
			<options/>
		</deployment>
		<general startup_environnement="1"/>
		<interface>
			<user splash_screen="false"/>
		</interface>
		<compiler>
			<options compilation_path="3" fat_binary="true"/>
			<typage default_for_button="2"/>
			<method_suffix methods="Methods"/>
		</compiler>
		<server>
			<network>
				<options publication_name="HowDoI" publication_port="19813" publish_at_startup="true" use_legacy_network_layer="false"/>
				<client_server use_encryption="false"/>
			</network>
			<ip_config>
				<allow_deny_table/>
			</ip_config>
		</server>
		<database>
			<misc use_ast_interpreter="false" standard_xpath="false" non_blocking_printing="false"/>
		</database>
		<web>
			<remote>
				<configuration port_number="80" session_mode="3" automatic_session_management="true"/>
			</remote>
			<standalone_server>
				<configuration session_mode="3" automatic_session_management="true"/>
			</standalone_server>
		</web>
	</com.4d>
</preferences>